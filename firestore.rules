rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorizedDevice() {
      return request.auth != null
        && get(/databases/$(database)/documents/authorizedDevices/$(request.auth.uid)).data.enabled == true;
    }
    match /household/utilities {
      allow get: if authorizedDevice();
      allow create, update: if authorizedDevice()
        && request.resource.data.keys().hasOnly(['schema', 'payload'])
        && request.resource.data.schema == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 850000;
    }
  }
}
